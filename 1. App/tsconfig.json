{
  "compilerOptions": {
    "target": "ES2025",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["dom", "esnext"],
    "noEmit": true,
    "strict": true,
    "pretty": true,
    /* Additional Checks */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    /* Module Resolution Options */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "allowJs": true,
    /* Off on purpose: this file is the passing gate, so `yarn typecheck` covers JS syntax and module
       resolution only. `yarn typecheck:strict:report` runs it with checkJs on and lists every error. */
    "checkJs": false,
    /* Skip type-checking of third-party .d.ts files (avoids cross-package @types drift).
       Standard practice; does NOT relax type-checking of our own source. */
    "skipLibCheck": true
  },
  "exclude": [
    "**/node_modules",
    "release",
    "2. Frontend/1. Source/8. DIST",
    "**/renderer.dev.js",
    "**/renderer.prod.js",
    "**/main.prod.js"
  ]
}
