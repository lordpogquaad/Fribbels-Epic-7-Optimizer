{
  "//typescript": [
    "Two TypeScript copies are installed on purpose here — do not tidy one away.",
    "'tsc7' (npm alias of typescript@7) runs the 'typecheck' script. 'typescript' 6.x exists only to satisfy typescript-eslint's peer range '>=4.8.4 <6.1.0' (see @typescript-eslint/typescript-estree's SUPPORTED_TYPESCRIPT_VERSIONS, verified against 8.68.0 in this tree).",
    "Yarn cannot nest a peer dependency, so an alias under a different package name is the only arrangement where the linter keeps TS6 while the type-checker is TS7.",
    "Always invoke TS7 by explicit path (node node_modules/tsc7/bin/tsc) because both 'typescript' and 'tsc7' declare bin 'tsc'.",
    "typescript-eslint only WARNS on an out-of-range TypeScript version by default (onUnsupportedTypeScriptVersion defaults to 'warn' in createParseSettings.js; it does not hard-throw) — verified in the installed 8.68.0 tree, not a hard failure mode.",
    "To collapse once typescript-eslint supports TS7 (tracking typescript-eslint issue #10940): delete 'tsc7', set 'typescript' to ^7.x, point 'typecheck' at plain 'tsc -p ./ --noEmit'."
  ],
  "name": "pog-e7-optimizer",
  "productName": "Pog E7 Optimizer",
  "main": "./5. Dev Only/main.dev.js",
  "author": {
    "name": "RexQian"
  },
  "version": "1.12.0",
  "description": "Epic 7 gear optimizer — Electron (jQuery renderer) + Java backend",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "yarn copy-assets && concurrently \"yarn build-main\" \"yarn build-renderer\"",
    "copy-assets": "node \"./4. Both/2. Build/1. Scripts/CopyAssets.js\"",
    "build-main": "cross-env NODE_ENV=production webpack --config \"./4. Both/1. Webpack/webpack.config.main.prod.js\"",
    "build-renderer": "cross-env NODE_ENV=production webpack --config \"./4. Both/1. Webpack/webpack.config.renderer.prod.js\"",
    "dev": "yarn copy-assets && cross-env START_HOT=1 node -r @babel/register \"./4. Both/2. Build/1. Scripts/CheckPortInUse.js\" && cross-env START_HOT=1 yarn start-renderer-dev",
    "electron-rebuild": "electron-rebuild --parallel --force --types prod,dev,optional --module-dir \"2. Frontend/1. Source\"",
    "lint": "cross-env NODE_ENV=development eslint . --cache",
    "lint-fix": "yarn --silent lint --fix; exit 0",
    "lint-styles": "stylelint --ignore-path .prettierignore '**/*.*(css|scss)'",
    "lint-styles-fix": "yarn --silent lint-styles --fix; exit 0",
    "package": "yarn build && electron-builder build --publish never",
    "package-all": "yarn build && electron-builder build -mwl",
    "package-mac": "yarn build && electron-builder build --mac",
    "package-linux": "yarn build && electron-builder build --linux",
    "package-win": "yarn build && electron-builder build --win --x64",
    "postinstall": "node -r @babel/register \"4. Both/2. Build/1. Scripts/CheckNativeDep.js\" && electron-builder install-app-deps",
    "postlint-fix": "prettier --ignore-path .prettierignore --single-quote --write '**/*.{js,jsx,json,html,css,less,scss,yml}'",
    "postlint-styles-fix": "prettier --ignore-path .prettierignore --single-quote --write '**/*.{css,scss}'",
    "preinstall": "node \"./4. Both/2. Build/1. Scripts/CheckYarn.js\"",
    "prestart": "yarn build",
    "start": "cross-env NODE_ENV=production electron \"./2. Frontend/1. Source/main.prod.js\"",
    "start-main-debug": "yarn start-main-dev --inspect=5858 --remote-debugging-port=9223",
    "start-main-dev": "cross-env START_HOT=1 NODE_ENV=development electron .",
    "start-renderer-dev": "cross-env NODE_ENV=development webpack serve --config \"4. Both/1. Webpack/webpack.config.renderer.dev.js\"",
    "typecheck": "node node_modules/tsc7/bin/tsc -p ./ --noEmit"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "cross-env NODE_ENV=development eslint --cache"
    ],
    "{*.json,.{babelrc,eslintrc,prettierrc,stylelintrc}}": [
      "prettier --ignore-path .prettierignore --parser json --write"
    ],
    "*.{css,scss}": [
      "stylelint --ignore-path .prettierignore --fix",
      "prettier --ignore-path .prettierignore --single-quote --write"
    ],
    "*.{html,md,yml}": [
      "prettier --ignore-path .prettierignore --single-quote --write"
    ]
  },
  "build": {
    "productName": "PogE7Optimizer",
    "appId": "com.lordpogquaad.poge7optimizer",
    "files": [
      "package.json",
      "node_modules/**",
      "5. Dev Only/main.dev.js",
      "5. Dev Only/LogControl.js",
      "2. Frontend/1. Source/package.json",
      "2. Frontend/1. Source/main.prod.js",
      "2. Frontend/1. Source/renderer.dev.js",
      "2. Frontend/1. Source/1. HTML/**",
      "2. Frontend/1. Source/2. CSS/**",
      "2. Frontend/1. Source/3. ASSETS/**",
      "2. Frontend/1. Source/4. JS/**",
      "2. Frontend/1. Source/8. DIST/**",
      "2. Frontend/1. Source/node_modules/**"
    ],
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": {
        "target": "default",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ],
      "category": "Development"
    },
    "directories": {
      "buildResources": "2. Frontend/2. Icons",
      "output": "release"
    },
    "extraResources": [
      {
        "from": "2. Frontend/1. Source/1. HTML/assets",
        "to": "resources"
      }
    ],
    "extraFiles": [
      "./1. Master/3. Jar/**",
      "./2. Frontend/1. Source/6. JSON/**",
      "./2. Frontend/1. Source/7. PY/**"
    ]
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/register": "^8.0.1",
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/webpack-env": "^1.18.8",
    "chalk": "^6.0.0",
    "concurrently": "^10.0.5",
    "core-js": "^3.50.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "detect-port": "^2.1.0",
    "electron": "^42.10.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "17.3.0",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.9.6",
    "style-loader": "^4.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "tsc7": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "webpack": "5.109.2",
    "webpack-bundle-analyzer": "^5.3.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "electron-debug": "^4.1.0",
    "electron-log": "^5.4.4",
    "node-abi": "^4.34.0",
    "regenerator-runtime": "^0.14.1",
    "source-map-support": "^0.5.21",
    "watchpack": "^2.5.2"
  },
  "browserslist": [
    "electron 42.0"
  ],
  "prettier": {
    "overrides": [
      {
        "files": [
          ".prettierrc",
          ".babelrc",
          ".eslintrc",
          ".stylelintrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ],
    "singleQuote": true,
    "endOfLine": "auto"
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard"
    ],
    "rules": {
      "selector-class-pattern": null,
      "selector-id-pattern": null,
      "no-descending-specificity": null
    }
  },
  "renovate": {
    "extends": [
      "bliss"
    ],
    "baseBranches": [
      "next"
    ]
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}
