{
  "//typescript": [
    "Two TypeScript copies are installed on purpose here — do not tidy one away.",
    "'tsc7' (npm alias of typescript@7) runs the 'typecheck' script. 'typescript' 6.x exists only to satisfy typescript-eslint's peer range '>=4.8.4 <6.1.0' (see @typescript-eslint/typescript-estree's SUPPORTED_TYPESCRIPT_VERSIONS, verified against 8.72.1 in this tree, peer still '<6.1.0' on 2026-10-30).",
    "Yarn cannot nest a peer dependency, so an alias under a different package name is the only arrangement where the linter keeps TS6 while the type-checker is TS7.",
    "Always invoke TS7 by explicit path (node node_modules/tsc7/bin/tsc) because both 'typescript' and 'tsc7' declare bin 'tsc'.",
    "typescript-eslint only WARNS on an out-of-range TypeScript version by default (onUnsupportedTypeScriptVersion defaults to 'warn' in createParseSettings.js; it does not hard-throw) — verified in the installed 8.72.1 tree, not a hard failure mode.",
    "To collapse once typescript-eslint supports TS7 (tracking typescript-eslint issue #10940): delete 'tsc7', set 'typescript' to ^7.x, point 'typecheck' at plain 'tsc -p ./ --noEmit'."
  ],
  "name": "pog-e7-optimizer",
  "productName": "Pog E7 Optimizer",
  "main": "./5. Dev Only/main.dev.js",
  "author": {
    "name": "lordpogquaad",
    "url": "https://github.com/lordpogquaad/Fribbels-Epic-7-Optimizer"
  },
  "version": "1.12.0",
  "description": "Epic 7 gear optimizer — Electron (jQuery renderer) + Java backend",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "yarn copy-assets && concurrently \"yarn build-main\" \"yarn build-renderer\"",
    "copy-assets": "node \"./4. Both/2. Build/1. Scripts/CopyAssets.js\"",
    "build-main": "cross-env NODE_ENV=production webpack --config \"./4. Both/1. Webpack/webpack.config.main.prod.js\"",
    "build-renderer": "cross-env NODE_ENV=production webpack --config \"./4. Both/1. Webpack/webpack.config.renderer.prod.js\"",
    "dev": "yarn copy-assets && cross-env START_HOT=1 node -r @babel/register \"./4. Both/2. Build/1. Scripts/CheckPortInUse.js\" && cross-env START_HOT=1 yarn start-renderer-dev",
    "electron-rebuild": "electron-rebuild --parallel --force --types prod,dev,optional --module-dir \"2. Frontend/1. Source\"",
    "lint": "cross-env NODE_ENV=development eslint . --cache",
    "lint:strict": "eslint -c eslint.strict.config.mjs .",
    "format": "prettier --ignore-path ../.prettierignore --write ..",
    "format:check": "prettier --ignore-path ../.prettierignore --check ..",
    "lint:md": "markdownlint-cli2 --config ../.markdownlint-cli2.jsonc \"../**/*.md\" \"#**/node_modules/**\"",
    "lint:ps": "cd .. && node \"$CLAUDE_CONFIG_DIR/tools/tools/lint-ps.mjs\"",
    "hooks:lint": "node \"$CLAUDE_CONFIG_DIR/tools/tools/lint-hooks.mjs\" --dir ../.claude/hooks",
    "lint:strict:report": "node \"$CLAUDE_CONFIG_DIR/tools/tools/lint-strict-report.mjs\" --repo . --out \"../.claude/plans/LINT-STRICT-REPORT.md\"",
    "sonar:report": "node \"$CLAUDE_CONFIG_DIR/tools/tools/diag-scan-repo.mjs\" --repo .. --report --out \"../.claude/plans/SONAR-REPORT.md\"",
    "lint:fix": "yarn lint --fix",
    "lint:styles": "stylelint '2. Frontend/1. Source/2. CSS/*.css'",
    "lint:styles:fix": "yarn lint:styles --fix",
    "lint:dead": "knip",
    "lint:deps-graph": "depcruise --config .dependency-cruiser.cjs \"2. Frontend/1. Source/4. JS\" \"5. Dev Only\" \"4. Both\"",
    "lint:dupes": "jscpd",
    "lint:java": "pwsh -NoProfile -NonInteractive -File \"1. Master/2. PS1/lint_java.ps1\"",
    "lint:py": "ruff check .. --exit-zero",
    "lint:py:types": "mypy \"2. Frontend/1. Source/7. PY/1. Scanner/1. Core/scanner.py\" ../add_rarity.py --ignore-missing-imports",
    "package": "yarn build && electron-builder build --publish never",
    "package-all": "yarn build && electron-builder build -mwl",
    "package-mac": "yarn build && electron-builder build --mac",
    "package-linux": "yarn build && electron-builder build --linux",
    "package-win": "yarn build && electron-builder build --win --x64",
    "postinstall": "node -r @babel/register \"4. Both/2. Build/1. Scripts/CheckNativeDep.js\" && electron-builder install-app-deps",
    "preinstall": "node \"./4. Both/2. Build/1. Scripts/CheckYarn.js\"",
    "start": "yarn build && cross-env NODE_ENV=production electron \"./2. Frontend/1. Source/main.prod.js\"",
    "start-main-debug": "yarn start-main-dev --inspect=5858 --remote-debugging-port=9223",
    "start-main-dev": "cross-env START_HOT=1 NODE_ENV=development electron .",
    "start-renderer-dev": "cross-env NODE_ENV=development webpack serve --config \"4. Both/1. Webpack/webpack.config.renderer.dev.js\"",
    "scan": "node \"./4. Both/2. Build/1. Scripts/ScanReport.mjs\"",
    "typecheck": "node node_modules/tsc7/bin/tsc -p ./ --noEmit",
    "typecheck:strict:report": "node \"./4. Both/2. Build/1. Scripts/TypecheckReport.mjs\""
  },
  "build": {
    "productName": "PogE7Optimizer",
    "appId": "com.lordpogquaad.poge7optimizer",
    "files": [
      "package.json",
      "node_modules/**",
      "5. Dev Only/main.dev.js",
      "5. Dev Only/LogControl.js",
      "5. Dev Only/FileLog.js",
      "2. Frontend/1. Source/package.json",
      "2. Frontend/1. Source/main.prod.js",
      "2. Frontend/1. Source/renderer.dev.js",
      "2. Frontend/1. Source/1. HTML/**",
      "2. Frontend/1. Source/2. CSS/**",
      "2. Frontend/1. Source/3. ASSETS/**",
      "2. Frontend/1. Source/4. JS/**",
      "2. Frontend/1. Source/8. DIST/**",
      "2. Frontend/1. Source/node_modules/**"
    ],
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": {
        "target": "default",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ],
      "category": "Development"
    },
    "directories": {
      "buildResources": "2. Frontend/2. Icons",
      "output": "release"
    },
    "extraResources": [
      {
        "from": "2. Frontend/1. Source/1. HTML/assets",
        "to": "resources"
      }
    ],
    "extraFiles": [
      "./1. Master/3. Jar/**",
      "./2. Frontend/1. Source/6. JSON/**",
      "./2. Frontend/1. Source/7. PY/**"
    ]
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "@babel/register": "^8.0.6",
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "chalk": "^6.0.1",
    "concurrently": "^10.0.6",
    "core-js": "^3.51.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "dependency-cruiser": "^18.7.0",
    "detect-port": "^2.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.3.2",
    "globals": "^17.13.0",
    "jscpd": "^5.4.2",
    "knip": "^6.43.0",
    "markdownlint-cli2": "^0.24.0",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.9.10",
    "sonarqube-scanner": "^5.0.2",
    "style-loader": "^4.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "tsc7": "npm:typescript@^7.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "webpack": "^5.112.2",
    "webpack-bundle-analyzer": "^5.4.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.1.0",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "electron-debug": "^5.0.0",
    "regenerator-runtime": "^0.14.1",
    "source-map-support": "^0.5.21"
  },
  "browserslist": [
    "electron 45.0"
  ],
  "stylelint": {
    "extends": [
      "stylelint-config-standard"
    ],
    "rules": {
      "selector-class-pattern": null,
      "selector-id-pattern": null,
      "no-descending-specificity": null
    }
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
