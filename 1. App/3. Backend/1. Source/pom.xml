<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>fribbels</groupId>
    <artifactId>backend</artifactId>
    <version>1.0.2</version>
    <properties>
        <maven.compiler.source>27</maven.compiler.source>
        <maven.compiler.target>27</maven.compiler.target>
        <maven.compiler.release>27</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>
    <dependencies>        <!-- https://mvnrepository.com/artifact/com.google.code.gson/gson -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.15.0</version>
        </dependency>        <!-- https://mvnrepository.com/artifact/com.google.guava/guava/versions -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.7.2-jre</version>
        </dependency>        <!-- https://mvnrepository.com/artifact/org.apache.commons/commons-collections4 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
            <version>4.6.0</version>
        </dependency>        <!-- https://mvnrepository.com/artifact/commons-io/commons-io -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.22.0</version>
        </dependency>        <!-- https://mvnrepository.com/artifact/org.apache.commons/commons-lang3 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.21.0</version>
        </dependency>        <!-- https://mvnrepository.com/artifact/org.junit.jupiter/junit-jupiter-api -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>        <!-- JUnit 5 engine — surefire needs it on the test classpath to discover/run the @Test methods -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>        <!-- https://mvnrepository.com/artifact/org.projectlombok/lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.48</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.aparapi</groupId>
            <artifactId>aparapi</artifactId>
            <version>3.0.2</version>
        </dependency>
        <dependency>
            <groupId>com.aparapi</groupId>
            <artifactId>aparapi-jni</artifactId>
            <version>1.4.3</version>
        </dependency>
    </dependencies>
    <build>
        <sourceDirectory>1. Java</sourceDirectory>
        <testSourceDirectory>1. Java/10. Tests</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.5.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <!-- Every package is compiled once from its real com/fribbels/* folder, so the numbered
                         junctions to them are excluded. Main.java has one copy, in com/fribbels/ (a hardlink
                         to a second copy once shipped a stale Main — 2026-08-28). -->
                    <excludes>
                        <exclude>1. Core/**</exclude>
                        <exclude>2. Model/**</exclude>
                        <exclude>3. DB/**</exclude>
                        <exclude>4. Handler/**</exclude>
                        <exclude>5. Request/**</exclude>
                        <exclude>6. Response/**</exclude>
                        <exclude>7. Enums/**</exclude>
                        <exclude>8. GPU/**</exclude>
                        <exclude>10. Tests/**</exclude>
                    </excludes>
                    <!-- JDK 23+ no longer runs annotation processors found only on the classpath;
                         declare Lombok explicitly as a processor and force full processing. -->
                    <proc>full</proc>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.48</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
                <configuration>
                    <argLine>                        --add-opens java.base/java.lang=ALL-UNNAMED                        --add-opens java.base/java.lang.reflect=ALL-UNNAMED                        --add-opens java.base/java.nio=ALL-UNNAMED                        --add-opens java.base/java.util=ALL-UNNAMED                    </argLine>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.8.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.fribbels.Main</mainClass>
                        </manifest>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <appendAssemblyId>true</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Report-only static analysis (yarn lint:java). No executions: it is bound to no phase, so
                 build_backend.ps1 never runs it. The plugin's bundled PMD (7.17) cannot parse Java 27, so
                 the net.sourceforge.pmd artifacts are overridden to 7.29.0, which can. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.28.0</version>
                <configuration>
                    <rulesets>
                        <ruleset>${project.basedir}/pmd-ruleset.xml</ruleset>
                    </rulesets>
                    <targetJdk>27</targetJdk>
                    <!-- Same exclusion as the compiler: the numbered folders are junctions to com/fribbels/*,
                         so each file is analysed once. Tests are added back through includeTests. -->
                    <excludes>
                        <exclude>**/1. Core/**</exclude>
                        <exclude>**/2. Model/**</exclude>
                        <exclude>**/3. DB/**</exclude>
                        <exclude>**/4. Handler/**</exclude>
                        <exclude>**/5. Request/**</exclude>
                        <exclude>**/6. Response/**</exclude>
                        <exclude>**/7. Enums/**</exclude>
                        <exclude>**/8. GPU/**</exclude>
                        <exclude>**/10. Tests/**</exclude>
                    </excludes>
                    <includeTests>true</includeTests>
                    <failOnViolation>false</failOnViolation>
                    <printFailingErrors>true</printFailingErrors>
                    <minimumPriority>5</minimumPriority>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-core</artifactId>
                        <version>7.29.0</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-java</artifactId>
                        <version>7.29.0</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-javascript</artifactId>
                        <version>7.29.0</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-jsp</artifactId>
                        <version>7.29.0</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>