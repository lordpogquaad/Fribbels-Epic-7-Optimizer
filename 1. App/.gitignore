# Backend build output — regenerated by build_backend.ps1; not loaded by the app
# (it runs 1. Master/3. Jar/backend.jar). `target/` is Maven's output; `2. Class/` was
# an old reorganized copy of it, removed 2026-06-20 (build no longer maintains it).
3. Backend/1. Source/target/
3. Backend/1. Source/2. Class/
# Bundled Maven toolchain — auto-downloaded + extracted by build_backend.ps1 when absent.
3. Backend/2. Apache Maven/

# Logs
logs
*.log

# Runtime data written by the app:
# Disk cache — re-fetched from the server at runtime (diskCache.js / Files.getCachePath()).
2. Frontend/1. Source/6. JSON/2. CACHE/cache/
# i18next missing-key dumps — written at runtime by saveMissing (Files.getLocalesPath()).
**/translation.missing.json

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release
.eslintcache

# Python tooling caches (importer / scanner)
**/.mypy_cache/
.ruff_cache/
__pycache__/

# Dependency directory
# https://www.npmjs.org/doc/misc/npm-faq.html#should-i-check-my-node_modules-folder-into-git
node_modules

# Yarn 4 install state — regenerated by `yarn install` (corepack manages the Yarn binary).
.yarn/install-state.gz

# OSX
.DS_Store

# App packaged (electron-builder output — build.directories.output)
release

# Webpack build artifacts — compiled from source, regenerated each build/run.
#   main:         webpack.config.main.prod.js        -> 2. Frontend/1. Source/main.prod.js     (yarn build)
#   renderer:     webpack.config.renderer.prod.js    -> 8. DIST/ (renderer.prod.js, style.css, assets) (yarn build)
#   dev renderer: webpack.config.renderer.dev.js     -> 2. Frontend/1. Source/renderer.dev.js  (yarn dev, writeToDisk)
2. Frontend/1. Source/main.prod.js
2. Frontend/1. Source/main.prod.js.map
2. Frontend/1. Source/renderer.dev.js
2. Frontend/1. Source/8. DIST/

# Webpack-emitted hash-named assets at the renderer output root (build artifacts;
# source fonts/images live in node_modules + 3. ASSETS; dev serves from memory)
2. Frontend/1. Source/*.woff2
2. Frontend/1. Source/*.woff
2. Frontend/1. Source/*.ttf
2. Frontend/1. Source/*.eot
2. Frontend/1. Source/*.svg

# Editor metadata — project uses VS Code; .idea (JetBrains) is ignored defensively.
.vscode
.idea

# Eclipse / m2e IDE metadata — project uses VS Code; any Eclipse files in the repo are
# orphaned cruft (the 3. XML set was Java-8-era + a stale pom copy, removed 2026-06-20).
.project
.classpath
.settings/
3. Backend/1. Source/3. XML/bin/
3. Backend/1. Source/3. XML/*.prefs

# Served hero-image dir is build output: CopyAssets.js flattens 3. ASSETS/1. PNG/** into it on
# every `yarn build` / `yarn dev`. The canonical source tree is 3. ASSETS/ (tracked). 2026-08-28.
2. Frontend/1. Source/1. HTML/assets/
