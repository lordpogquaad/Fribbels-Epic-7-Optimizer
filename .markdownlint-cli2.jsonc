{
  "gitignore": true,
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    // Personal and archived folders, and the Copilot-era leftovers slated for removal (FIX LIST R8).
    "2. Personal/**",
    "trashcan/**",
    // Session journal: git-hidden by its own nested .gitignore, which `gitignore: true` does not read.
    ".remember/**",
    ".github/**",
    // A translated copy of the upstream README, not edited here.
    "localization/**",
    // Generated by `yarn lint:strict:report`, `yarn sonar:report` and `yarn typecheck:strict:report`.
    ".claude/plans/LINT-STRICT-REPORT.md",
    ".claude/plans/SONAR-REPORT.md",
    ".claude/plans/TYPECHECK-REPORT.md"
  ],
  "config": {
    "default": true,
    // markdownlint's own list of the rules that conflict with Prettier, all off. It is the one
    // home of that list: do not copy its rules here. The path is relative to this file, because the
    // repo root has no node_modules and the VS Code extension resolves from here, not from "1. App/".
    "extends": "./1. App/node_modules/markdownlint/style/prettier.json",
    // Formatting Prettier also owns that the style above does not name: list marker, final
    // newline, blank lines around tables, table column alignment.
    "MD004": false,
    "MD047": false,
    "MD058": false,
    "MD060": false
  }
}
