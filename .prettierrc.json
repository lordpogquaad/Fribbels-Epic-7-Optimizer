{
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "all",
  "endOfLine": "auto",
  "overrides": [
    {
      "files": "*.md",
      "options": { "embeddedLanguageFormatting": "off", "proseWrap": "preserve" }
    },
    { "files": "*.jsonc", "options": { "trailingComma": "none" } }
  ]
}
