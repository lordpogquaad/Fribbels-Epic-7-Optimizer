// Gate commands as tasks, each with a problem matcher so findings land in the Problems panel.
// Run from the Terminal menu: Run Task. Commands run from `1. App/` (`.claude/CLAUDE.md` -> Commands).
// None of these runs on folder open; to load the last Sonar report at startup, add
// "runOptions": { "runOn": "folderOpen" } to "Sonar: problems (last scan)" (needs Allow Automatic Tasks once).
{
  "version": "2.0.0",
  "tasks": [
    // `yarn lint`; the built-in $eslint-stylish matcher reads ESLint's stylish output (absolute paths).
    {
      "label": "Lint: ESLint (yarn lint)",
      "type": "shell",
      "command": "yarn",
      "args": ["lint"],
      "options": { "cwd": "${workspaceFolder}/1. App" },
      "group": "test",
      "presentation": { "reveal": "silent", "clear": true },
      "problemMatcher": "$eslint-stylish"
    },
    // `yarn typecheck` is tsc7 (TypeScript 7 native). --pretty false gives `file(line,col): error TSn: msg`,
    // which $tsc reads; its paths are relative to the task's cwd, so `1. App` resolves them.
    {
      "label": "Typecheck: tsc7 (yarn typecheck)",
      "type": "shell",
      "command": "yarn",
      "args": ["typecheck", "--pretty", "false"],
      "options": { "cwd": "${workspaceFolder}/1. App" },
      "group": "build",
      "presentation": { "reveal": "silent", "clear": true },
      "problemMatcher": "$tsc"
    },
    // `yarn lint:py` is `python -m ruff check .. --exit-zero`. Concise output is `path:line:col: CODE message`, paths
    // relative to the cwd. The Ruff extension contributes no matcher; Ruff has no severity, so all are warnings.
    {
      "label": "Lint: ruff (yarn lint:py)",
      "type": "shell",
      "command": "yarn",
      "args": ["lint:py", "--output-format", "concise"],
      "options": { "cwd": "${workspaceFolder}/1. App" },
      "group": "test",
      "presentation": { "reveal": "silent", "clear": true },
      "problemMatcher": {
        "owner": "ruff",
        "source": "ruff",
        "severity": "warning",
        "fileLocation": ["relative", "${workspaceFolder}/1. App"],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): ([A-Z]+\\d+) (?:\\[\\*\\] )?(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      }
    },
    // `yarn lint:py:types` is mypy on scanner.py. --show-column-numbers adds the column. mypy prints a path
    // relative to the cwd for repo files and an absolute one for site-packages, so autoDetect.
    {
      "label": "Typecheck: mypy (yarn lint:py:types)",
      "type": "shell",
      "command": "yarn",
      "args": ["lint:py:types", "--show-column-numbers"],
      "options": { "cwd": "${workspaceFolder}/1. App" },
      "group": "test",
      "presentation": { "reveal": "silent", "clear": true },
      "problemMatcher": {
        "owner": "mypy",
        "source": "mypy",
        "fileLocation": ["autoDetect", "${workspaceFolder}/1. App"],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (error|warning): (.*?)(?:  \\[([\\w-]+)\\])?$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5,
          "code": 6
        }
      }
    },
    // Maven compile with the repo's Maven, from the pom folder. `compile` has no `clean` and runs no tests,
    // but it writes `target/`, which the Java language server shares: run one mvn at a time
    // (`.claude/rules/machine.md`). pom.xml sets -Xlint:all, so warnings print too. Compiler lines look like
    // `[ERROR] /C:/path/File.java:[line,col] message`; the regexp drops the leading slash before the drive.
    {
      "label": "Java: compile (mvn compile)",
      "type": "shell",
      "command": "${workspaceFolder}/1. App/3. Backend/2. Apache Maven/apache-maven-3.10.0/bin/mvn.cmd",
      "args": ["-B", "compile"],
      "options": {
        "cwd": "${workspaceFolder}/1. App/3. Backend/1. Source",
        "env": { "JAVA_HOME": "C:\\Program Files\\Java\\latest\\jdk-27" }
      },
      "group": "build",
      "presentation": { "reveal": "silent", "clear": true },
      "problemMatcher": {
        "owner": "maven-javac",
        "source": "javac",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^\\[(ERROR|WARNING)\\] /?(.+?):\\[(\\d+),(\\d+)\\] (.*)$",
          "severity": 1,
          "file": 2,
          "line": 3,
          "column": 4,
          "message": 5
        }
      }
    },
    // Sonar findings for every file, not only open ones. Renders the last report that `yarn sonar:report`
    // (or the scan task below) wrote, through the shared diag-scan-repo tool (config-tool.mjs finds the
    // config repo). Line shape: `<abs path>:<line>:<col>: <level> <rule> <message>`. Quick, no scan; with no
    // report yet it prints one line and exits 0.
    {
      "label": "Sonar: problems (last scan)",
      "type": "shell",
      "command": "node",
      "args": [
        "${workspaceFolder}/1. App/4. Both/2. Build/1. Scripts/config-tool.mjs",
        "diag-scan-repo.mjs",
        "--render",
        "${workspaceFolder}/.claude/plans/SONAR-REPORT.json",
        "--problems"
      ],
      "presentation": { "reveal": "silent", "clear": true },
      "problemMatcher": {
        "owner": "diag-scan-repo",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+): (error|warning|info) (\\S+) (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    },
    // Full repo scan (minutes). Same as `yarn sonar:report:problems`: it rewrites the tracked
    // `.claude/plans/SONAR-REPORT.md` and `.json` that the task above renders.
    {
      "label": "Sonar: scan repo → problems",
      "type": "shell",
      "command": "node",
      "args": [
        "${workspaceFolder}/1. App/4. Both/2. Build/1. Scripts/config-tool.mjs",
        "diag-scan-repo.mjs",
        "--repo",
        "${workspaceFolder}",
        "--report",
        "--out",
        "${workspaceFolder}/.claude/plans/SONAR-REPORT.md",
        "--problems"
      ],
      "presentation": { "reveal": "always", "clear": true },
      "problemMatcher": {
        "owner": "diag-scan-repo",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+): (error|warning|info) (\\S+) (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    }
  ]
}
