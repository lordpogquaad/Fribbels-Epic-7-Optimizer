{
  "codeQL.createQuery.qlPackLocation": "f:\\Epic Seven Screenshots Only\\New folder",
  "json.schemas": [
    {
      "fileMatch": ["nodemon.json", ".nodemonrc", ".nodemonrc.json"],
      "url": "https://json.schemastore.org/nodemon.json"
    }
